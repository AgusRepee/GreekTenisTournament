# Frontend (Vite): copiar a .env.local y ajustar.

# Base de la API backend (sin slash final)
VITE_API_URL=http://localhost:3001

# Desarrollo sin backend: `local`. Producción Hostinger/MySQL: `api`.
VITE_DATA_SOURCE=local

# Opcional solo en desarrollo: Bearer fijo (evita login). En producción usar POST /api/admin/auth/login.
# VITE_ADMIN_TOKEN=

# `true`: creación/eliminación avanzada de torneos y jugadores y ajustes avanzados en admin.
# VITE_ENABLE_ADVANCED_ADMIN_CREATION=true

# Frontend Vite - staging/produccion con API + MySQL.
# Copiar a `.env.staging` para `npm run build:staging` o a `.env.production` para `npm run build`.

# URL publica del backend Node en Hostinger, sin slash final.
VITE_API_URL=https://api.greektennis.com

# Activa adaptadores REST para resultados, programacion, ligas, eliminacion y ranking publico.
VITE_DATA_SOURCE=api

# No usar token fijo en produccion. El admin debe entrar por /login contra POST /api/admin/auth/login.
# VITE_ADMIN_TOKEN=

# Opcional: habilita herramientas avanzadas de creacion/eliminacion admin.
# VITE_ENABLE_ADVANCED_ADMIN_CREATION=true

# Backend Hostinger - MySQL + Prisma.
# Copiar a `.env` en el servidor o cargar estos valores en el panel Node.js de Hostinger.
# No commitear `.env` real.

# MySQL Hostinger.
# Usar variables por piezas evita tener que escapar caracteres especiales de la password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u592173310_TorneosGreek
DB_NAME=u592173310_TorneosGreek
DB_PASSWORD=CAMBIAR_EN_HOSTINGER

# Alternativa: DATABASE_URL completa. Si la password contiene `@`, codificarlo como `%40`.
# DATABASE_URL="mysql://u592173310_TorneosGreek:MYSQL_PASSWORD@localhost:3306/u592173310_TorneosGreek"
#
# Caracteres especiales en DATABASE_URL:
# @ -> %40
# # -> %23
# : -> %3A
# / -> %2F
# % -> %25

# API.
# Hostinger puede inyectar PORT automaticamente; definirlo solo si el panel lo pide.
PORT=3001
CORS_ORIGIN=https://greektennis.com

# Admin.
ADMIN_PASSWORD=COMPLETAR_PASSWORD_ADMIN
JWT_SECRET=COMPLETAR_CLAVE_LARGA_SEGURA
JWT_EXPIRES_SECONDS=28800

# Frontend Vite - produccion con API + MySQL.
# Copiar a `.env.production` o cargar estas variables en Hostinger.
# No commitear `.env.production` real.

VITE_DATA_SOURCE=api
VITE_API_URL=https://api.greektennis.com

# No usar token fijo en produccion. El admin debe entrar por /login y JWT.
# VITE_ADMIN_TOKEN=

# Opcional: habilita herramientas avanzadas de creacion/eliminacion admin.
# VITE_ENABLE_ADVANCED_ADMIN_CREATION=true
